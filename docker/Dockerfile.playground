# ParseDock Playground: static SPA + same-origin /v1 proxy.
#
#   docker build -f docker/Dockerfile.playground -t parsedock-playground:0.1.0 .
#
# The API key is NOT part of this image: nginx injects it at start-up from the environment
# (`PARSEDOCK_PROXY_TOKEN`), so the bundle that ships to the browser contains no secret.
FROM node:22.20.0-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e AS build
WORKDIR /app
# Dependencies first: the lockfile is the cache key, and `npm ci` fails on any drift.
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
# `envsubst` on /etc/nginx/templates/*.template is built into the official image.
ENV PARSEDOCK_API_UPSTREAM=http://api-1:8080 \
    PARSEDOCK_PROXY_TOKEN= \
    NGINX_PORT=8080
COPY deploy/nginx.playground.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
