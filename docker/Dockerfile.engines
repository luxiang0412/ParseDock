# ParseDock CPU parse-worker image: the control-plane binary plus real parsers.
#
#   docker build -f docker/Dockerfile.engines -t parsedock-worker-cpu:0.1.0 .
#
# Components (pinned):
#   xberg CLI 1.3.10      text/Office/OCR via bundled libs + system tesseract
#   docling-rs 2.53.3     layout + TableFormer + OCR (ONNX Runtime CPU)
#   tesseract 5.x         OCR backend for xberg
#   ONNX models models-v1 for docling-rs (~530 MiB)
#
# GPU workers use docker/Dockerfile.worker-gpu (CUDA base + MinerU).
FROM parsedock:0.1.0 AS base
USER root

# Versions must match images.lock.json (scripts/verify-pins.sh enforces it).
ARG XBERG_VERSION=1.3.10
ARG DOCLING_RS_VERSION=2.53.3
ARG DOCLING_RS_MODELS_TAG=models-v1
ARG TESSERACT_LANGS="tesseract-ocr-eng tesseract-ocr-chi-sim"

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tesseract-ocr ${TESSERACT_LANGS} \
 && rm -rf /var/lib/apt/lists/*

# xberg CLI ships its shared libraries next to the binary.
RUN mkdir -p /opt/xberg \
 && curl -fsSL -o /tmp/xberg.tgz \
    "https://github.com/xberg-io/xberg/releases/download/v${XBERG_VERSION}/xberg-cli-x86_64-unknown-linux-gnu.tar.gz" \
 && tar -xzf /tmp/xberg.tgz -C /opt/xberg --strip-components=1 \
 && rm /tmp/xberg.tgz \
 && chmod 0755 /opt/xberg/xberg \
 && LD_LIBRARY_PATH=/opt/xberg /opt/xberg/xberg --version

# docling-rs CLI + ONNX models (layout, OCR, TableFormer).
RUN curl -fsSL -o /tmp/docling-rs \
    "https://github.com/docling-project/docling.rs/releases/download/v${DOCLING_RS_VERSION}/docling-rs-v${DOCLING_RS_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
 && tar -xzf /tmp/docling-rs -C /usr/local/bin \
 && rm /tmp/docling-rs \
 && chmod 0755 /usr/local/bin/docling-rs \
 && mkdir -p /opt/docling-rs \
 && cd /opt/docling-rs \
 && curl -fsSL "https://raw.githubusercontent.com/docling-project/docling.rs/master/scripts/install/download_dependencies.sh" \
    | bash -s -- --no-asr --no-chunk \
 && /usr/local/bin/docling-rs --version

ENV PARSEDOCK_XBERG_BIN=/opt/xberg/xberg \
    PARSEDOCK_XBERG_LIB_DIR=/opt/xberg \
    PARSEDOCK_DOCLING_RS_BIN=/usr/local/bin/docling-rs \
    PARSEDOCK_DOCLING_RS_MODELS=/opt/docling-rs \
    PARSEDOCK_ENGINES=native,xberg,docling-rs \
    PARSEDOCK_WORK_DIR=/work

USER 10001:10001
CMD ["--role", "worker", "--engines", "native,xberg,docling-rs"]
