# Optional GPU worker image (MinerU 4.1 flash tier, CUDA).
#
#   docker build -f docker/Dockerfile.worker-gpu -t parsedock-worker-gpu:0.1.0 .
#
# Requires the NVIDIA Container Toolkit on the host. The CPU image and the CPU
# compose file do not depend on this image in any way.
FROM nvidia/cuda:13.2.0-runtime-ubuntu24.04@sha256:36cccda4bebc3b0b1ebe1907ead8169cf144d45df890be871b36b304cf91145a AS mineru

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    MINERU_HOME=/work/mineru-home
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/mineru \
 && /opt/mineru/bin/pip install --upgrade pip \
 && /opt/mineru/bin/pip install "mineru==4.1.2"
# Telemetry is disabled at image build time; MinerU 4.1 enables it by default.
RUN /opt/mineru/bin/mineru telemetry disable || true

FROM parsedock:0.1.0
USER root
COPY --from=mineru /opt/mineru /opt/mineru
COPY --from=mineru /usr/lib/python3.12 /usr/lib/python3.12
COPY --from=mineru /usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu
RUN useradd --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin parsedock || true \
 && mkdir -p /work/mineru-home && chown -R 10001:10001 /work
ENV PATH="/opt/mineru/bin:${PATH}" \
    MINERU_HOME=/work/mineru-home \
    PARSEDOCK_MINERU_BIN=/opt/mineru/bin/mineru \
    PARSEDOCK_ENGINES=mineru \
    PARSEDOCK_DEVICE_TYPE=gpu
USER 10001:10001
# MinerU needs its local daemon; the entrypoint starts it, then the worker.
COPY docker/gpu-entrypoint.sh /usr/local/bin/gpu-entrypoint.sh
RUN chmod 0755 /usr/local/bin/gpu-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/gpu-entrypoint.sh"]
