# Optional GPU worker image (MinerU 4.1 flash tier, CUDA).
#
#   docker build -f docker/Dockerfile.worker-gpu -t parsedock-worker-gpu:0.1.0 .
#
# Requires the NVIDIA Container Toolkit on the host. The CPU image and the CPU
# compose file do not depend on this image in any way.
FROM nvidia/cuda:13.2.0-runtime-ubuntu24.04@sha256:36cccda4bebc3b0b1ebe1907ead8169cf144d45df890be871b36b304cf91145a AS mineru

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    MINERU_HOME=/work/mineru-home
# libvulkan1 (loader) + the X11 libs the NVIDIA Vulkan ICD links against are
# copied into the final image by the broad /usr/lib/x86_64-linux-gnu COPY below.
# MinerU's GPU path is WebGPU-through-Vulkan on Linux; without the loader its
# device selection fails with "libvulkan.so.1: cannot open shared object file".
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates curl \
      libvulkan1 libx11-6 libxext6 libxcb1 \
 && rm -rf /var/lib/apt/lists/*
# The NVIDIA driver itself is mounted at run time by the container toolkit, so the
# ICD manifest has to be shipped here: the toolkit does not provide it.
RUN mkdir -p /opt/vulkan-icd \
 && printf '%s\n' '{"file_format_version":"1.0.1","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.3.242"}}' \
      > /opt/vulkan-icd/nvidia_icd.json
RUN python3 -m venv /opt/mineru \
 && /opt/mineru/bin/pip install --upgrade pip \
 && /opt/mineru/bin/pip install "mineru==4.1.2"
# Telemetry is disabled at image build time; MinerU 4.1 enables it by default.
RUN /opt/mineru/bin/mineru telemetry disable || true

FROM parsedock:0.1.0
USER root
COPY --from=mineru /opt/mineru /opt/mineru
# The venv's python3 is a symlink to /usr/bin/python3, so the interpreter binary and
# libpython from the Ubuntu stage have to come along; copying only the stdlib leaves
# every entry point with a broken shebang ("mineru: not found").
COPY --from=mineru /usr/bin/python3.12 /usr/bin/python3.12
COPY --from=mineru /usr/lib/python3.12 /usr/lib/python3.12
COPY --from=mineru /usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu
COPY --from=mineru /usr/lib/python3 /usr/lib/python3
COPY --from=mineru /opt/vulkan-icd/nvidia_icd.json /usr/share/vulkan/icd.d/nvidia_icd.json
RUN ln -sf /usr/bin/python3.12 /usr/bin/python3 \
 && ln -sf /usr/bin/python3.12 /usr/bin/python \
 && useradd --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin parsedock || true \
 && mkdir -p /work/mineru-home && chown -R 10001:10001 /work
ENV PATH="/opt/mineru/bin:${PATH}" \
    MINERU_HOME=/work/mineru-home \
    PARSEDOCK_MINERU_BIN=/opt/mineru/bin/mineru \
    PARSEDOCK_WORK_ROOT=/work \
    PARSEDOCK_ENGINES=mineru \
    PARSEDOCK_DEVICE_TYPE=gpu
# Stays root only until the entrypoint has prepared a mounted work volume; the
# entrypoint immediately re-executes itself as uid 10001 via setpriv.
USER root
# MinerU needs its local daemon; the entrypoint starts it, then the worker.
# --chmod avoids a chmod layer, which fails on some build hosts when the base
# image's /usr/local/bin is not writable by the build user.
COPY --chmod=0755 docker/gpu-entrypoint.sh /usr/local/bin/gpu-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/gpu-entrypoint.sh"]
