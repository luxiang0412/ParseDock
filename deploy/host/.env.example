# Copy to .env and fill in. Never commit .env.
#
# Secrets: generate each with `openssl rand -hex 24`.
PARSEDOCK_INTERNAL_TOKEN=
# API keys, `<token>:<owner>[:scopes]`; comma-separated. Scopes default to all three.
PARSEDOCK_API_KEYS=
# The Playground's own token — a bare token (no ":owner"). Add the same token to
# PARSEDOCK_API_KEYS as `<token>:playground`, or let compose do it (see README).
PLAYGROUND_KEY=

# Public ports on the host.
API_PORT=8080
PLAYGROUND_PORT=8090

# Limits. The audit corpus has 52-74 MiB files, hence 128.
PARSEDOCK_MAX_UPLOAD_MB=128
PARSEDOCK_MAX_PAGES=2000
PARSEDOCK_RATE_LIMIT=200
PARSEDOCK_RATE_BURST=100
PARSEDOCK_RESULT_TTL=1h
WORKER_CONCURRENCY=2
# tesseract language for scans: "zh" for Chinese, "eng" for Latin text.
PARSEDOCK_XBERG_OCR_LANG=eng

# Images (must be present on the host; see README).
PARSEDOCK_IMAGE=parsedock:0.1.0
PARSEDOCK_WORKER_IMAGE=parsedock-worker-cpu:0.1.0
PARSEDOCK_PLAYGROUND_IMAGE=parsedock-playground:0.1.0
