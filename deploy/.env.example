# Copy to deploy/.env and fill in. Never commit deploy/.env (git-ignored).

# Shared secret between API replicas and the coordinator (random, long).
PARSEDOCK_INTERNAL_TOKEN=
# API keys, `<token>:<owner>[:scopes]` — comma separated. Generate: openssl rand -hex 24
PARSEDOCK_API_KEYS=
# Public ports for the two API replicas.
API_PORT_1=8080
API_PORT_2=8082
# Optional images/tags for the CPU stack.
PARSEDOCK_IMAGE=parsedock:0.1.0
PARSEDOCK_WORKER_IMAGE=parsedock-worker-cpu:0.1.0

# Playground (docker compose --profile playground). Bare token (no ":owner"); the compose file
# appends "<PLAYGROUND_KEY>:playground" to PARSEDOCK_API_KEYS for the API replicas, and nginx
# injects it as the bearer. It never reaches the browser.
PLAYGROUND_KEY=
PLAYGROUND_PORT=8090
PARSEDOCK_PLAYGROUND_IMAGE=parsedock-playground:0.1.0
