<?xml version="1.0" encoding="UTF-8"?>
<!--
  Integration test for the generated Java client.

  The client itself is generated into sdk/java-generated and is deliberately not
  hand-edited; this module exists so the client can be exercised against a live
  ParseDock stack without touching generated sources.

    mvn -f sdk/java-generated/pom.xml -DskipTests install
    mvn -f sdk/java-client-test/pom.xml test \
        -Dparsedock.base=http://127.0.0.1:18190 -Dparsedock.token=itest

  scripts/sdk-check.sh starts the stack and passes the two properties.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.parsedock</groupId>
  <artifactId>parsedock-client-test</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>parsedock client integration test</name>

  <properties>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.parsedock</groupId>
      <artifactId>parsedock-client</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- Surefire's default includes are *Test/Test*/...; this module's class
               is an integration test and must be picked up explicitly. -->
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <parsedock.base>${parsedock.base}</parsedock.base>
            <parsedock.token>${parsedock.token}</parsedock.token>
            <parsedock.fixture>${parsedock.fixture}</parsedock.fixture>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
