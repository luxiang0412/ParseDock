   "prov": [],
   "self_ref": "#/texts/0",
   "text": "Dock Throughput Review"
  },
  {
   "children": [],
   "content_layer": "body",
   "formatting": {
    "bold": false,
    "italic": false,
    "script": "baseline",
    "strikethrough": false,
    "underline": false
   },
   "label": "text",
   "orig": "The pilot program moved 128,400 pallets across three regional hubs in the second quarter, a 12.5 percent increase over the same period last year. Average dock-to-stock time fell from 4.2 hours to 3.1 hours after the scheduling change, while the number of missed appointments dropped by 38 percent. Warehouse B remains the constraint: its inbound lane utilisation reached 94 percent during peak weeks.",
   "parent": {
    "$ref": "#/texts/0"
   },
   "prov": [],
   "self_ref": "#/texts/1",
   "text": "The pilot program moved 128,400 pallets across three regional hubs in the second quarter, a 12.5 percent increase over the same period last year. Average dock-to-stock time fell from 4.2 hours to 3.1 hours after the scheduling change, while the number of missed appointments dropped by 38 percent. Warehouse B remains the constraint: its inbound lane utilisation reached 94 percent during peak weeks."
  },
